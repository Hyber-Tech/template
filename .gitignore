# One pattern per line — git has no separator, and no brace expansion.
# Globs that ARE supported: * ? [abc] **

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
.spyderproject
.spyproject
.ropeproject

# Environment and secrets (.env holds shared, non-secret values and IS tracked)
.env.local
.env.*.local
*.pem
*.key
.venv
venv/
venv.bak/
env/
env.bak/
ENV/
__pypackages__/
.pdm.toml

# Logs
*.log
*-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# Dependencies and build output
node_modules/
.npm/
.yarn/
vendor/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg
*.egg-info/
.installed.cfg
MANIFEST
*.manifest
*.spec
*.so
target/
out/
.pybuilder/

# Byte-compiled and generated
__pycache__/
*.py[cod]
*$py.class
*.mo
*.pot
*.sage.py
cython_debug/

# Tests, coverage and caches
.cache
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage*
coverage.xml
nosetests.xml
htmlcov/
cover/
*.cover
*.py,cover
.mypy_cache/
*dmypy.json
.pyre/
.pytype/

# Framework and tool state
local_settings.py
db.sqlite3*
instance/
.webassets-cache
.scrapy
celerybeat-schedule
celerybeat.pid
.ipynb_checkpoints
profile_default/
ipython_config.py

# Docs output
docs/_build/
/site

# Supabase CLI local state (migrations are tracked)
supabase/.branches/
supabase/.temp/
